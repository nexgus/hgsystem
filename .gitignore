__pycache__/
.claude/

# Go build outputs
/bin/

# Embedded frontend copy (regenerated by build.sh before each go build)
/hgsys/cmd/hgsystem/dist/

# Windows icon resource (regenerated from icon.ico by build.sh before go build)
/hgsys/cmd/hgsystem/rsrc_windows_amd64.syso

# Frontend build outputs
/frontend/node_modules/
/frontend/dist/
/frontend/bindings/
/frontend/tsconfig.tsbuildinfo

# Update marker dropped by self-update before restart
/updated

# Generated MSI manifest (built from msi/hgsystem.wxs.in by build.sh)
/msi/hgsystem.wxs

# Private data
/data/
/db_backup/

<?xml version="1.0" encoding="utf-8"?>
<!--
  hgsystem MSI installer 定義檔 (template).

  此檔為 build.sh 生成 msi/hgsystem.wxs 之來源, @VERSION@ 於 build.sh
  以 sed 替換為 hgsys/pkg/version/version.go 內之 String. hgsystem.wxs
  不入版控.

  關鍵設計決策:
    * UpgradeCode 為固定 GUID, 一旦寫定不可變更, 變更即視為新產品.
    * ProductCode (Product@Id) 設 *, wixl 編譯時每次自動產生新 GUID,
      搭配 MajorUpgrade 實現「裝新版自動移除舊版」行為.
    * AllowSameVersionUpgrades=yes 允許同版本直接覆蓋, 便於開發期反覆 build.
    * 降級維持預設拒絕.
    * 安裝範圍 perMachine, 安裝目錄 %ProgramFiles%\hgsystem\,
      Environment 以 System=yes 寫入系統 PATH (HKLM), 全使用者可見.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="hgsystem"
           Language="1033"
           Version="@VERSION@"
           Manufacturer="Nexgus"
           UpgradeCode="7C12F6AC-EDAB-4539-BFB3-645EDD61BA4C">

    <!--
      MSI metadata (Name / Description) 一律使用 ASCII. Windows Installer 以
      IsValidCodePage 驗證資料庫與 Summary Information stream 的 codepage,
      UTF-8 (65001) 非系統安裝之 code page, 驗證不過會使 msiexec 拒絕開啟封裝.
      故不設 SummaryCodepage, 由 wixl 以預設 cp1252 寫入; 內容皆 ASCII 故無亂碼.
    -->
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="hgsystem - optician customer and worksheet management system"
             Manufacturer="hgsystem" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="hgsystem.cab" EmbedCab="yes" />

    <!--
      Icon 與 ARPPRODUCTICON 使「新增/移除程式」清單於本產品名稱旁顯示眼鏡
      圖示. SourceFile 之相對路徑以 wixl 之 CWD (repo root) 為基準, 指向與
      Windows exe 嵌入之 rsrc 相同的 icon.ico. Icon@Id 依慣例以 .ico 結尾.
    -->
    <Icon Id="hgsystem.ico" SourceFile="hgsys/cmd/hgsystem/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="hgsystem.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="hgsystem">

          <Component Id="HgsystemExe" Guid="*" Win64="yes">
            <File Id="HgsystemExeFile"
                  Source="bin/hgsystem-@VERSION@-windows-amd64.exe"
                  Name="hgsystem.exe"
                  KeyPath="yes" />
            <!--
              Start 功能表捷徑 (非 advertised). Name 須為 ASCII 以維持資料庫
              neutral codepage (見 6.3 節); 圖示沿用 exe 內嵌之 rsrc icon.
              捷徑檔隨本 component 一併安裝/解除, 無須額外 RemoveFile.
            -->
            <Shortcut Id="HgsystemStartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="hgsystem"
                      Target="[INSTALLDIR]hgsystem.exe"
                      WorkingDirectory="INSTALLDIR" />
          </Component>

          <!--
            Environment 元素不可作為 KeyPath, 故以 dummy registry value
            (HKLM\Software\hgsystem\installed) 充當本 component 之 KeyPath,
            為 WiX 慣例做法.
          -->
          <Component Id="HgsystemPath" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM"
                           Key="Software\hgsystem"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <Environment Id="UpdatePath"
                         Name="PATH"
                         Action="set"
                         Part="last"
                         System="yes"
                         Permanent="no"
                         Value="[INSTALLDIR]" />
          </Component>

        </Directory>
      </Directory>

      <!-- Start 功能表 (全使用者 Programs), 供上方 Shortcut 放置入口. -->
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <Feature Id="Main" Title="hgsystem" Level="1">
      <ComponentRef Id="HgsystemExe" />
      <ComponentRef Id="HgsystemPath" />
    </Feature>

  </Product>
</Wix>
